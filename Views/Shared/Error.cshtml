@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <div class="display-5 mb-3" aria-hidden="true">⚠️</div>
                    <h1 class="h3 fw-bold text-danger mb-3">Произошла ошибка</h1>
                    <p class="text-muted">Не удалось обработать запрос. Попробуйте повторить действие позже.</p>

                    @if (Model.ShowRequestId)
                    {
                        <p class="small text-muted">
                            Идентификатор запроса: <code>@Model.RequestId</code>
                        </p>
                    }

                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">На главную</a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">В каталог</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
