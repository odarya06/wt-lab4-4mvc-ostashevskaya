@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isHome = controller == "Home" && action == "Index";
    var isCatalog = controller == "Product" && action is "Index" or "Details";
    var isCreate = controller == "Product" && action == "Create";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Складской учёт — учебное ASP.NET Core MVC приложение для управления складскими позициями." />
    <title>@ViewData["Title"] — Складской учёт</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21V8l9-5 9 5v13" />
                            <path d="M3 21h18" />
                            <path d="M9 21v-6h6v6" />
                            <path d="M9 11h6" />
                        </svg>
                    </span>
                    <span>Складской учёт</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : null)" asp-controller="Home" asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isCatalog ? "active" : null)" asp-controller="Product" asp-action="Index">Каталог</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isCreate ? "active" : null)" asp-controller="Product" asp-action="Create">Добавить товар</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="app-footer mt-auto">
        <div class="container py-4">
            <div class="row gy-3 align-items-center">
                <div class="col-md-6">
                    <div class="fw-semibold text-white">Складской учёт</div>
                    <div class="small text-white-50">Учебный проект WT-4 — ASP.NET Core MVC</div>
                </div>
                <div class="col-md-6 text-md-end small text-white-50">
                    &copy; @DateTime.Now.Year · Данные хранятся в памяти приложения
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
