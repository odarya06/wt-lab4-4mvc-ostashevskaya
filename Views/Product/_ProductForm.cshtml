@model Product
@{
    var categories = (IReadOnlyList<string>)ViewBag.Categories;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4" role="alert"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label fw-semibold"></label>
        <input asp-for="Name" class="form-control" placeholder="Например, Ноутбук Lenovo ThinkPad" autocomplete="off" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Sku" class="form-label fw-semibold"></label>
        <input asp-for="Sku" class="form-control" placeholder="SKU-1001" autocomplete="off" />
        <span asp-validation-for="Sku" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Category" class="form-label fw-semibold"></label>
        <input asp-for="Category" class="form-control" list="categoryOptions" placeholder="Выберите или введите категорию" autocomplete="off" />
        <datalist id="categoryOptions">
            @foreach (var category in categories)
            {
                <option value="@category"></option>
            }
        </datalist>
        <span asp-validation-for="Category" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Supplier" class="form-label fw-semibold"></label>
        <input asp-for="Supplier" class="form-control" placeholder="Например, ООО «ТехноСнаб»" autocomplete="off" />
        <span asp-validation-for="Supplier" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Quantity" class="form-label fw-semibold"></label>
        <input asp-for="Quantity" class="form-control" type="number" min="0" max="1000000" />
        <span asp-validation-for="Quantity" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Price" class="form-label fw-semibold"></label>
        <div class="input-group">
            <input asp-for="Price" class="form-control" type="text" inputmode="decimal" placeholder="0,00" />
            <span class="input-group-text">₽</span>
        </div>
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ReceivedAt" class="form-label fw-semibold"></label>
        <input asp-for="ReceivedAt" class="form-control" type="date" />
        <span asp-validation-for="ReceivedAt" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label fw-semibold"></label>
        <textarea asp-for="Description" class="form-control" rows="3"
                  placeholder="Краткое описание позиции, характеристики, условия хранения"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check form-switch p-3 ps-5 bg-light rounded-3">
            <input asp-for="IsAvailable" class="form-check-input" role="switch" />
            <label asp-for="IsAvailable" class="form-check-label fw-semibold"></label>
            <div class="small text-muted">Выключите, если позиция временно недоступна к отгрузке.</div>
        </div>
    </div>
</div>
