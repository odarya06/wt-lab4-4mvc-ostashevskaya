@model Product
@{
    ViewData["Title"] = "Добавление товара";
}

<div class="container py-4 py-lg-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Каталог</a></li>
            <li class="breadcrumb-item active" aria-current="page">Добавление</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <span class="category-icon category-icon-lg" aria-hidden="true">➕</span>
                        <div>
                            <h1 class="h2 fw-bold mb-0">Добавление товара</h1>
                            <p class="text-muted mb-0">Новая складская позиция</p>
                        </div>
                    </div>

                    <form asp-action="Create" method="post">
                        <partial name="_ProductForm" model="Model" />

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4">Сохранить</button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Назад</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
