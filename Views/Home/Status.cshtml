@{
    ViewData["Title"] = "Ошибка";
    var code = ViewData["StatusCode"] is int statusCode ? statusCode : 404;
    var title = code == 404 ? "Страница не найдена" : "Что-то пошло не так";
    var description = code == 404
        ? "Запрошенная позиция или страница не существует. Возможно, товар был удалён."
        : "Не удалось обработать запрос. Попробуйте вернуться на главную страницу.";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center">
                <div class="card-body p-4 p-lg-5">
                    <div class="display-1 fw-bold text-primary mb-2">@code</div>
                    <h1 class="h3 fw-bold mb-3">@title</h1>
                    <p class="text-muted mb-4">@description</p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">На главную</a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">В каталог</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
